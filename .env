# Playwright session storage path (browser profile directory)
PLAYWRIGHT_USER_DATA_DIR=./browser_profile

# Discord credentials (used ONLY for first-time login via setup_login.py)
DISCORD_EMAIL=jn.shantnu@gmail.com
